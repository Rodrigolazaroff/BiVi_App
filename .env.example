# Copiar a .env.local y completar con los valores reales.
# En Vercel se cargan las mismas tres en Settings -> Environment Variables.

# Supabase -> Project Settings -> API
# La anon key es publica por diseno: lo que protege los datos es RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio. Solo se usa en el servidor (app/api/chat/route.ts).
GEMINI_API_KEY=
