# Copiar a .env.local y completar con los valores reales.
# En Vercel se cargan las mismas en Settings -> Environment Variables.

# Supabase -> Project Settings -> API
# La anon key (sb_publishable_...) es publica por diseno: lo que protege los datos es RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...) — SOLO en el servidor, sin prefijo NEXT_PUBLIC_.
# La usa unicamente /api/push/remind, que corre sin sesion de usuario.
SUPABASE_SECRET_KEY=

# Google AI Studio. Solo se usa en el servidor (app/api/chat/route.ts).
GEMINI_API_KEY=

# Web Push. Generar el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cualquier cadena larga al azar. Protege /api/push/remind (lo llama pg_cron).
CRON_SECRET=
